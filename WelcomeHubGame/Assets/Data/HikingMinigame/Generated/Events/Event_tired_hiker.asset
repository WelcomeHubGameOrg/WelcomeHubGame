  m_EditorClassIdentifier: Assembly-CSharp::HikingMinigame.Events.EventDefinition
  <Id>k__BackingField: tired_hiker
  <Title>k__BackingField: A Tired Hiker
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: A hiker sits by the trail, exhausted. They still
    have a long way to go.
  <Weight>k__BackingField: 1
  <MaxOccurrences>k__BackingField: 1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Give them your energy bar
    <RequiredItem>k__BackingField: {fileID: 11400000, guid: ae668b24e0ff3f0b581e077958bad971, type: 2}
    <Outcome>k__BackingField:
      <Text>k__BackingField: They thank you and insist you take their spare rain
        jacket in return.
      <Effects>k__BackingField:
      - rid: 6632890833693573292
      - rid: 6632890833693573293
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Walk together for a while
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Good company makes the kilometers fly by.
      <Effects>k__BackingField:
      - rid: 6632890833693573294
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Wish them luck
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You nod and walk on.
      <Effects>k__BackingField: []
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
