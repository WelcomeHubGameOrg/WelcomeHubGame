  m_Name: Event_stream_crossing
  m_EditorClassIdentifier: Assembly-CSharp::HikingMinigame.Events.EventDefinition
  <Id>k__BackingField: stream_crossing
  <Title>k__BackingField: A Stream Crossing
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: A fast stream crosses the trail. There is no bridge
    here.
  <Weight>k__BackingField: 2
  <MaxOccurrences>k__BackingField: -1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Wade through
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: The water is ice cold. Your feet go numb.
      <Effects>k__BackingField:
      - rid: 6632890833693573262
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Hop across on the stones
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Stone, stone, stone. Dry feet!
      <Effects>k__BackingField: []
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.4
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: A stone wobbles, and you twist your ankle as you fall
          in.
        <Effects>k__BackingField:
        - rid: 6632890833693573263
  - <Text>k__BackingField: Walk upstream to a footbridge
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: It's a long detour, but you stay dry.
      <Effects>k__BackingField:
      - rid: 6632890833693573264
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
