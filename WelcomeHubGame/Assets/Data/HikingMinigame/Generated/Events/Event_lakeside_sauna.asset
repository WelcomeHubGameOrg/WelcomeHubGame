  <Id>k__BackingField: lakeside_sauna
  <Title>k__BackingField: A Lakeside Sauna
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: A small public sauna by the lake, already warm. Steam
    rises from the chimney.
  <Weight>k__BackingField: 1
  <MaxOccurrences>k__BackingField: 1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Enjoy the sauna
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: The heat melts the tiredness out of your legs.
      <Effects>k__BackingField:
      - rid: 6632890833693573245
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Sauna, then jump into the lake
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Hot, cold, hot again. You feel like a new person. This
        is the Finnish way.
      <Effects>k__BackingField:
      - rid: 6632890833693573246
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.3
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: The lake is ice cold and you stay in too long.
        <Effects>k__BackingField:
        - rid: 6632890833693573247
