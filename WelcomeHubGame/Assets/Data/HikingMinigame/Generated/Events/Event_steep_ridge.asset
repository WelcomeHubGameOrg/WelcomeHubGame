  <Id>k__BackingField: steep_ridge
  <Title>k__BackingField: A Steep Ridge
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: The trail splits. One path climbs a rocky ridge,
    the other winds around it.
  <Weight>k__BackingField: 2
  <MaxOccurrences>k__BackingField: -1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Climb up for the view
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Forest and lakes as far as you can see. Worth every
        step.
      <Effects>k__BackingField:
      - rid: 6632890833693573267
      - rid: 6632890833693573268
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.3
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: Loose rocks slip under your feet and you scrape your
          knee.
        <Effects>k__BackingField:
        - rid: 6632890833693573269
  - <Text>k__BackingField: Take the path around
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Longer, but easy going.
      <Effects>k__BackingField:
      - rid: 6632890833693573270
