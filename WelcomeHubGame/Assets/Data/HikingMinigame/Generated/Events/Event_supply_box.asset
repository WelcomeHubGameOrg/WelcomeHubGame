  <Id>k__BackingField: supply_box
  <Title>k__BackingField: A Hiker's Supply Box
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: A wooden box at a trail crossing. A note says, "Take
    what you need, leave what you can."
  <Weight>k__BackingField: 1
  <MaxOccurrences>k__BackingField: 2
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Take an energy bar
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You find an energy bar and put it in your bag.
      <Effects>k__BackingField:
      - rid: 6632890833693573230
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Take a first aid kit
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You find a small first aid kit and put it in your bag.
      <Effects>k__BackingField:
      - rid: 6632890833693573231
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Take the mosquito repellent
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Half a bottle left. You put it in your bag.
      <Effects>k__BackingField:
      - rid: 6632890833693573232
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Leave it for someone who needs it more
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You feel good about leaving it for the next hiker.
      <Effects>k__BackingField:
      - rid: 6632890833693573233
