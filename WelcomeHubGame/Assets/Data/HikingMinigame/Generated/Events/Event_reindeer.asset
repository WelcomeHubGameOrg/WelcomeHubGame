  m_Name: Event_reindeer
  m_EditorClassIdentifier: Assembly-CSharp::HikingMinigame.Events.EventDefinition
  <Id>k__BackingField: reindeer
  <Title>k__BackingField: Reindeer on the Trail
  <Icon>k__BackingField: {fileID: 21300000, guid: b4463c76d9d134e188ead9e486d458d1, type: 3}
  <Description>k__BackingField: A small herd of reindeer is grazing right on the
    trail.
  <Weight>k__BackingField: 2
  <MaxOccurrences>k__BackingField: 2
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Wait quietly until they move on
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: After a while, they calmly wander into the forest.
      <Effects>k__BackingField:
      - rid: 6632890833693573215
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Walk around them through the bushes
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You give them space, but the detour is tiring.
      <Effects>k__BackingField:
      - rid: 6632890833693573216
      - rid: 6632890833693573217
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Try to pet one
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: The herd scatters in panic. Reindeer are not pets.
      <Effects>k__BackingField:
      - rid: 6632890833693573218
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.2
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: The herd scatters, and a startled reindeer knocks
          you over.
        <Effects>k__BackingField:
        - rid: 6632890833693573219
        - rid: 6632890833693573220
