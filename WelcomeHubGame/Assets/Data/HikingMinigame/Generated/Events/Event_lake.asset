  m_Name: Event_lake
  m_EditorClassIdentifier: Assembly-CSharp::HikingMinigame.Events.EventDefinition
  <Id>k__BackingField: lake
  <Title>k__BackingField: A Clear Lake
  <Icon>k__BackingField: {fileID: 21300000, guid: 2b51b27d7924b9b2896c2437372e822a, type: 3}
  <Description>k__BackingField: One of Finland's many lakes, calm and glittering
    in the sun.
  <Weight>k__BackingField: 3
  <MaxOccurrences>k__BackingField: -1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Go for a swim
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: The water is wonderfully refreshing.
      <Effects>k__BackingField:
      - rid: 6632890833693573305
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.3
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: The water is much colder than it looked. You shiver
          for a long time.
        <Effects>k__BackingField:
        - rid: 6632890833693573306
  - <Text>k__BackingField: Filter some lake water
    <RequiredItem>k__BackingField: {fileID: 11400000, guid: 824d168d8118dcc72a60092b5c5fd916, type: 2}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Clean, cold water. You drink as much as you like.
      <Effects>k__BackingField:
      - rid: 6632890833693573307
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Drink straight from the lake
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Cool, fresh water.
      <Effects>k__BackingField:
      - rid: 6632890833693573308
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0.3
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: Your stomach does not agree with the untreated water.
        <Effects>k__BackingField:
        - rid: 6632890833693573309
  - <Text>k__BackingField: Wash up with soap
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: You feel fresh, but the soap ends up in the lake.
      <Effects>k__BackingField:
      - rid: 6632890833693573310
      - rid: 6632890833693573311
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
