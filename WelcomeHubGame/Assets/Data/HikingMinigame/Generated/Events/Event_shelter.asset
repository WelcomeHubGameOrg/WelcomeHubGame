  m_Name: Event_shelter
  m_EditorClassIdentifier: Assembly-CSharp::HikingMinigame.Events.EventDefinition
  <Id>k__BackingField: shelter
  <Title>k__BackingField: A Lean-to Shelter
  <Icon>k__BackingField: {fileID: 21300000, guid: f0184cd0f5003478fa1cfe1e42268567, type: 3}
  <Description>k__BackingField: An open wilderness shelter with a fire ring. Anyone
    may stay here, and you always make room if someone else arrives later.
  <Weight>k__BackingField: 2
  <MaxOccurrences>k__BackingField: -1
  <Trigger>k__BackingField: 0
  <Choices>k__BackingField:
  - <Text>k__BackingField: Rest and make room for others
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: Two hikers arrive late. You move your things and share
        the fire.
      <Effects>k__BackingField:
      - rid: 6632890833693573300
      - rid: 6632890833693573301
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Use wood from the woodshed
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: A warm fire and a hot meal. Just what you needed.
      <Effects>k__BackingField:
      - rid: 6632890833693573302
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
  - <Text>k__BackingField: Break branches off living trees
    <RequiredItem>k__BackingField: {fileID: 0}
    <Outcome>k__BackingField:
      <Text>k__BackingField: The green wood smokes badly, and the trees will carry
        the scars for years.
      <Effects>k__BackingField:
      - rid: 6632890833693573303
      - rid: 6632890833693573304
    <Risk>k__BackingField:
      <Chance>k__BackingField: 0
      <ReducedBy>k__BackingField: []
      <Outcome>k__BackingField:
        <Text>k__BackingField: 
        <Effects>k__BackingField: []
